# Carbon Group 2.0 Environment Configuration
# For production GitHub Pages (static mode), no environment variables are strictly required.
# To connect a live backend for the Admin CMS, create a Firebase project and fill in the following:

VITE_BASE=/carbon/

# Firebase Project Configuration (Optional: Enables Real Admin & Cloud Storage)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
